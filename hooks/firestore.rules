rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── USERS ───────────────────────────────────────────────
    match /users/{userId} {
      // Only the owner or an admin can read a specific user document
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list all users (prevents mass PII scraping)
      allow list: if isAdmin();
      // Owner can write their own doc; role cannot be escalated
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['fullName', 'email']);
      allow update: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == resource.data.role);

      match /selfAssessments/{assessmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /journalEntries/{journalId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /initialProfileSurveys/{surveyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /presence/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    // ─── ADMINS ──────────────────────────────────────────────
    // NOTE: `allow read: if signedIn()` is kept intentionally so students can
    // browse admins/counselors in the messaging directory. Admin docs should
    // avoid storing sensitive PII beyond what's needed for directory display.
    match /admins/{adminId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isOwner(adminId);
      allow delete: if false;
    }

    // ─── CONVERSATIONS ───────────────────────────────────────
    match /conversations/{conversationId} {
      allow get: if signedIn()
        && request.auth.uid in resource.data.participants
        || isAdmin();

      allow list: if (signedIn() && request.auth.uid in resource.data.participants) || isAdmin();

      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      allow update: if (signedIn() && request.auth.uid in resource.data.participants) || isAdmin();

      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if isParticipant() || isAdmin();
        allow create: if isParticipant() && request.auth.uid == request.resource.data.senderId;
        // Messages are immutable — no editing after sending
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── ANNOUNCEMENTS ───────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin();

      // Reads subcollection — tracks which students have read each announcement
      match /reads/{readId} {
        // Students can only read their own read receipt; admins can read all
        allow read: if isOwner(readId) || isAdmin();
        // Create/update must match the authenticated user AND the uid field
        allow create, update: if signedIn()
          && isOwner(readId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
  }
}
