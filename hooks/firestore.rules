rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ==========================
    // USERS
    // ==========================
    match /users/{userId} {
      allow list, get: if signedIn();
      allow write: if isOwner(userId);

      match /selfAssessments/{assessmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /journalEntries/{journalId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /initialProfileSurveys/{surveyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /presence/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================
    // ADMINS
    // ==========================
    match /admins/{adminId} {
      // Any signed-in user can read admin docs (for counselor search / messaging directory)
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isOwner(adminId);
      allow delete: if false;
    }

    // ==========================
    // CONVERSATIONS
    // ==========================
    match /conversations/{conversationId} {

      // GET: Allow any signed-in user to check if a conversation exists.
      // getDoc() is called before creating a conversation to avoid duplicates,
      // but the document won't exist yet so resource.data is null.
      // Once the doc exists, only participants (or admins) can read it.
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.participants
        || isAdmin()
      );

      // LIST: Only participants can list their conversations.
      allow list: if (signedIn() && request.auth.uid in resource.data.participants) || isAdmin();

      // CREATE: Creator must include themselves in participants.
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      // UPDATE: Only participants can update conversation metadata.
      allow update: if (signedIn() && request.auth.uid in resource.data.participants) || isAdmin();

      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if isParticipant() || isAdmin();
        allow create: if isParticipant() && request.auth.uid == request.resource.data.senderId;
        allow update: if (request.auth.uid == resource.data.senderId) || isAdmin();
        allow delete: if false;
      }
    }

    // ==========================
    // ANNOUNCEMENTS
    // ==========================
    match /announcements/{announcementId} {
      // Any signed-in user can read announcements
      allow read: if signedIn();
      // Only admins can create/delete announcements
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Only admins can update announcement metadata
      allow update: if isAdmin();

      // Reads subcollection — tracks which students have read each announcement
      match /reads/{readId} {
        // Anyone signed-in can list reads (needed for getUnreadCount)
        // and can read/get their own read receipt
        allow read: if signedIn();
        // Students can mark announcements as read (create/update their own doc)
        allow create, update: if signedIn() && isOwner(readId);
        allow delete: if false;
      }
    }
  }
}