rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── USERS ───────────────────────────────────────────────
    match /users/{userId} {
      // Signed-in students can read any user doc so peer chats can
      // refresh display names; list is already open to signed-in users
      // for the messaging directory, so this exposes no new fields.
      allow get: if isOwner(userId) || isAdmin() || signedIn();
      // Signed-in users can list users for the messaging directory
      allow list: if signedIn();
      // Owner can write their own doc; admins can update any user doc; role cannot be escalated
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['fullName', 'email'])
        && request.resource.data.role == 'student';
      allow update: if (isOwner(userId) || isAdmin())
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == resource.data.role);

      match /selfAssessments/{assessmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /journalEntries/{journalId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      // Constellation Weaver — the student's private night sky. Stored as a
      // subcollection so access follows the same ownership model as journals.
      match /constellationStars/{starId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /initialProfileSurveys/{surveyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /presence/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    // ─── ADMINS ──────────────────────────────────────────────
    // NOTE: `allow read: if signedIn()` is kept intentionally so students can
    // browse admins/counselors in the messaging directory. Admin docs should
    // avoid storing sensitive PII beyond what's needed for directory display.
    // Writes are restricted to Super Admins (custom claim). An admin may still
    // update their own profile, but never the privileged role fields.
    match /admins/{adminId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.superAdmin == true;
      allow update: if signedIn()
        && (request.auth.token.superAdmin == true
            || (isOwner(adminId)
                && !request.resource.data.diff(resource.data)
                     .affectedKeys()
                     .hasAny(['role', 'isSuperAdmin', 'email'])));
      allow delete: if signedIn() && request.auth.token.superAdmin == true;
    }

    // ─── CONVERSATIONS ───────────────────────────────────────
    match /conversations/{conversationId} {
      // Participants can read/write their own conversations. Conversations that
      // predate the `participants` field (legacy) are readable by their original
      // participants — identified via studentId/adminId or participantNames —
      // so the client can backfill `participants` and messaging keeps working.
      function isParticipant() {
        return signedIn() && resource.data.participants != null
          && request.auth.uid in resource.data.participants;
      }

      function isLegacyParticipant() {
        return resource.data.participants == null
          && (request.auth.uid == resource.data.studentId
              || request.auth.uid == resource.data.adminId
              || (resource.data.participantNames != null
                  && request.auth.uid in resource.data.participantNames));
      }

      // For list operations, `resource` is available per-document, so the same
      // participation checks used by get/update apply.
      // Allow get on non-existent docs so clients can check existence
      // before creating a conversation (getDoc returns null, not an error).
      // NOTE: get()/exists()-based rules DO work alongside where-filtered list
      // queries (verified against the Firestore emulator).
      allow get: if !exists(/databases/$(database)/documents/conversations/$(conversationId))
        || isParticipant()
        || isLegacyParticipant()
        || isAdmin();

      allow list: if isAdmin() || isParticipant() || isLegacyParticipant();

      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      // Participants can update. Legacy conversations may ONLY be updated to
      // add the missing `participants` field (client-side migration).
      allow update: if isAdmin()
        || isParticipant()
        || (isLegacyParticipant()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']));

      // Admins may clean up any conversation. Peer-to-peer conversations can be
      // deleted by their participants (see the messages delete rule below).
      allow delete: if isAdmin()
        || (resource.data.type == 'peer' && request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        function isMsgParticipant() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return convo.participants != null
            ? request.auth.uid in convo.participants
            : (request.auth.uid == convo.studentId
                || request.auth.uid == convo.adminId
                || (convo.participantNames != null
                    && request.auth.uid in convo.participantNames));
        }

        allow read: if isMsgParticipant() || isAdmin();
        allow create: if isMsgParticipant() && request.auth.uid == request.resource.data.senderId;
        // Messages are immutable except for soft-delete: the sender (or an
        // admin) may only set the `deleted` flag to true, never edit content.
        allow update: if (isMsgParticipant()
            && request.auth.uid == resource.data.senderId
            || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
          && request.resource.data.deleted == true;
        // Hard delete: admins anywhere; peer participants may only clear messages
        // inside a peer conversation (e.g. deleting their own chat). Guidance
        // conversations stay immutable to protect the audit trail.
        allow delete: if isAdmin()
          || (isMsgParticipant()
              && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'peer');
      }
    }

    // ─── REPORTS ──────────────────────────────────────────────
    // Student-reported conversations for admin moderation.
    // Students can only create reports; only admins can read/list them.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── ANNOUNCEMENTS ───────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin();

      // Reads subcollection — tracks which students have read each announcement
      match /reads/{readId} {
        // Students can only read their own read receipt; admins can read all
        allow read: if isOwner(readId) || isAdmin();
        // Create/update must match the authenticated user AND the uid field
        allow create, update: if signedIn()
          && isOwner(readId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // ─── SAFEGUARDING & FOLLOW-UP ───────────────────────────────
    // Case records and audit logs for the guidance office. Students are never
    // permitted to read or write these collections. Only admins can read, and
    // only admins can create/update cases. Audit log entries are immutable
    // (append-only) and may only be created by admins.
    match /safeguardingCases/{caseId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'PENDING_REVIEW';
      allow update: if isAdmin();
      allow delete: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /auditLogs/{logId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ─── SUPPORT WORKFLOWS ─────────────────────────────────────
    // Non-clinical support workflow records created by admins for authorized
    // follow-up. Students can never read or write these. No journal content
    // or AI conversation data is stored here.
    match /supportWorkflows/{workflowId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
